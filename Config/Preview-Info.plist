<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLIsDataBasedPreview</key>
			<true/>
			<key>QLSupportsSearchableItems</key>
			<false/>
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- 一般文字與設定檔 -->
				<string>public.plain-text</string>
				<string>public.utf8-plain-text</string>
				<string>public.utf16-plain-text</string>
				<string>com.apple.log</string>
				<string>public.json</string>
				<string>public.xml</string>
				<string>public.yaml</string>
				<string>public.toml</string>
				<string>com.microsoft.ini</string>
				<string>com.apple.property-list</string>
				<string>com.apple.xcode.strings-text</string>
				<string>com.apple.xcode.configsettings</string>
				<string>com.apple.xcode.projectdata</string>
				<string>com.apple.xcode.entitlements-property-list</string>
				<string>org.w3.webvtt</string>
				<string>public.patch-file</string>
				<!-- 文件 / 表格 -->
				<string>net.daringfireball.markdown</string>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
				<!-- 程式碼 -->
				<string>public.source-code</string>
				<string>public.script</string>
				<string>public.shell-script</string>
				<string>public.bash-script</string>
				<string>public.zsh-script</string>
				<string>public.csh-script</string>
				<string>public.swift-source</string>
				<string>public.c-source</string>
				<string>public.c-header</string>
				<string>public.c-plus-plus-source</string>
				<string>public.c-plus-plus-header</string>
				<string>public.objective-c-source</string>
				<string>public.objective-c-plus-plus-source</string>
				<string>com.sun.java-source</string>
				<string>com.netscape.javascript-source</string>
				<string>com.microsoft.typescript</string>
				<string>public.python-script</string>
				<string>public.ruby-script</string>
				<string>public.php-script</string>
				<string>public.perl-script</string>
				<string>org.iso.sql</string>
				<string>public.css</string>
				<string>public.make-source</string>
				<string>public.assembly-source</string>
				<string>public.fortran-90-source</string>
				<string>public.protobuf-source</string>
				<string>com.apple.rez-source</string>
				<!-- 壓縮檔 -->
				<string>public.zip-archive</string>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<!-- 主程式宣告的補充類型 -->
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
				<string>public.ksh-script</string>
				<string>com.apple.terminal.shell-script</string>
				<string>com.apple.metal</string>
				<string>public.geojson</string>
				<string>dev.quickseemd.markdown</string>
				<string>dev.quickseemd.xml-text</string>
				<string>dev.quickseemd.data-file</string>
				<string>dev.quickseemd.source-code</string>
				<string>dev.quickseemd.config-text</string>
				<string>dev.quickseemd.markup-text</string>
				<string>dev.quickseemd.sqlite</string>
				<string>dev.quickseemd.notebook</string>
				<!-- 沒有副檔名或未知類型：以內容判斷（文字 → 程式碼檢視，二進位 → 資訊＋十六進位） -->
				<string>public.unix-executable</string>
				<string>public.data</string>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewProvider</string>
	</dict>
</dict>
</plist>
